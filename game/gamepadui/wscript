#! /usr/bin/env python
# encoding: utf-8
#
# GamepadUI, ported from https://github.com/Joshua-Ashton/HL2-GamepadUI
# Built as a separate "gamepadui" module that the client loads when the game
# is started with -gamepadui (see game/client/cdll_client_int.cpp).
#
# Supported games: hl2, episodic (Episode 1 and Episode 2) and portal.
# Select the game with --build-games, same as game/client.

from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'gamepadui'

# Per-game preprocessor definitions, mirroring gamepadui_{hl2,episodic,portal}.vpc
games = {
	'hl2':      ['GAMEPADUI_GAME_HL2'],
	'episodic': ['GAMEPADUI_GAME_HL2', 'GAMEPADUI_GAME_EPISODIC'],
	'portal':   ['GAMEPADUI_GAME_PORTAL'],
}

def options(opt):
	return

def configure(conf):
	# game/client sets this too; set it here so we don't depend on ordering.
	conf.env.GAMES = conf.options.GAMES

def build(bld):
	# Other games (hl1, cstrike, dod, ...) have no GamepadUI.
	if bld.env.GAMES not in games.keys():
		return

	source = [
		'../../public/vgui_controls/vgui_controls.cpp',
		'../../common/language.cpp',
		'gamepadui_achievements.cpp',
		'gamepadui_basepanel.cpp',
		'gamepadui_button.cpp',
		'gamepadui_frame.cpp',
		'gamepadui_genericconfirmation.cpp',
		'gamepadui_interface.cpp',
		'gamepadui_mainmenu.cpp',
		'gamepadui_newgame.cpp',
		'gamepadui_savegame.cpp',
		'gamepadui_options.cpp',
		'gamepadui_util.cpp',
		'../../public/tier0/memoverride.cpp',
	]

	if bld.env.GAMES == 'portal':
		source += ['gamepadui_bonusmaps.cpp']

	includes = [
		'.',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
		'../../vgui2/include',
		'../../vgui2/controls',
	]

	defines = ['GAMEPADUI_DLL', 'VERSION_SAFE_STEAM_API_INTERFACES']
	defines += games[bld.env.GAMES]

	# Order matters: these are static libs and GNU ld resolves symbols
	# left-to-right, so a library must come *before* the libraries whose
	# symbols it uses. Unlike game/client there is no other object file that
	# pulls mathlib_base.o in early, so vtf and bitmap (bitmap needs
	# pfVectorNormalize) have to sit before tier1/mathlib too. vtf uses
	# bitmap, hence vtf first. Otherwise: undefined references to
	# CUtlMemoryPool::* and pfVectorNormalize at link time.
	libs = [
		'tier0',
		'vgui_controls',
		'matsys_controls',
		'vtf',
		'bitmap',
		'tier1',
		'tier2',
		'tier3',
		'mathlib',
		'vstdlib',
		'choreoobjects',
		'SDL2',  # gamepadui_options.cpp queries display bounds; also provides SDL.h
		'ZLIB',
	]

	if bld.env.DEST_OS == 'win32':
		libs += ['USER32', 'WINMM']

	# Same layout as game/client: next to the other libraries on Android,
	# <game>/bin everywhere else.
	install_path = bld.env.PREFIX
	if bld.env.DEST_OS != 'android':
		install_path += '/' + bld.env.GAMES + '/bin'

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)
